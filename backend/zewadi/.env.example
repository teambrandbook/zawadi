# ─── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-server-ip

# ─── Database ─────────────────────────────────────────────────────────────────
DB_ENGINE=postgresql
DB_NAME=zawadi
DB_USER=zawadi
DB_PASSWORD=your-strong-password
DB_HOST=db
DB_PORT=5432

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://your-server-ip:3000

# Google OAuth
# Create these in Google Cloud Console -> APIs & Services -> Credentials.
# Authorized redirect URI:
# http://localhost:8000/api/account/google/callback/
GOOGLE_CLIENT_ID=your_real_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_real_client_secret
