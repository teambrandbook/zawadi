# ── Domain ────────────────────────────────────────────────────────────────────
# Your server's domain or IP (used by Traefik for routing)
DOMAIN=yourdomain.com

# ── Django ────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=zawadi
DB_USER=zawadi
DB_PASSWORD=your-strong-db-password

# ── Redis ─────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
REDIS_PASSWORD=your-strong-redis-password
# REDIS_URL is auto-derived from REDIS_PASSWORD — only set this to override
# REDIS_URL=redis://:your-strong-redis-password@redis:6379/0

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Zawadi <noreply@yourdomain.com>

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Frontend ──────────────────────────────────────────────────────────────────
# Embedded in the Next.js image at build time
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# ── Security (leave as-is for HTTPS production) ───────────────────────────────
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
